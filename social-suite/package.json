{
  "name": "social-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One Cloudflare Worker: scheduled Instagram publishing plus comment-keyword and DM automation.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute social-suite --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute social-suite --local --file=./schema.sql",
    "check": "node scripts/check.mjs",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
